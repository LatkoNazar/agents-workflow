#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# .agents/githooks/pre-push — Universal Push Guard for ALL Coding Agents
# Blocks non-interactive agent pushes unless explicitly approved by the user
# (via ALLOW_GIT_PUSH=1 or interactive terminal confirmation).
# ==============================================================================

if [[ "${ALLOW_GIT_PUSH:-0}" == "1" ]]; then
  exit 0
fi

# If running in a non-interactive shell (e.g. an autonomous coding agent like Codex/Claude/Cursor),
# block automatic push and instruct the agent to ask the user for approval first.
if [[ ! -t 0 ]]; then
  echo "⚠️  [pre-push] Remote push requires explicit user approval." >&2
  echo "   Ask the user for confirmation in chat, then run: ALLOW_GIT_PUSH=1 git push ..." >&2
  exit 1
fi

exit 0

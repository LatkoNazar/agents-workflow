#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# .agents/githooks/pre-commit — Universal Gate for ALL Coding Agents
# (Works identically in Codex, Claude Code, Antigravity, Cursor, Windsurf, CLI)
# 1. Blocks staging of .env / secret files
# 2. Runs ./.agents/scripts/verify.sh --affected before allowing the commit
# ==============================================================================

# 1. Block .env files (except .env.example / .env.sample / .env.template)
STAGED_ENV="$(git diff --cached --name-only | grep -E '(^|/)\.env(\b|\.[a-zA-Z0-9_-]+)' | grep -vE '\.env\.(example|sample|template)$' || true)"
if [[ -n "$STAGED_ENV" ]]; then
  echo "❌ [pre-commit] Blocked: Attempting to commit .env secret file(s):" >&2
  echo "$STAGED_ENV" | sed 's/^/   /' >&2
  exit 1
fi

# 2. Skip code verification if only ticket/spec markdown files changed
STAGED_CODE="$(git diff --cached --name-only | grep -vE '^(\.agents/specs/|\.agents/tickets/|GLOSSARY\.md|README\.md)' || true)"
if [[ -z "$STAGED_CODE" ]]; then
  exit 0
fi

# 3. Run fast affected verification loop
if [[ -x "./.agents/scripts/verify.sh" ]]; then
  echo "==> [pre-commit] Running ./.agents/scripts/verify.sh --affected..."
  ./.agents/scripts/verify.sh --affected
fi
